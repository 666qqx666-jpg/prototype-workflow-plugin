{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.prototype-design-workflow/change-manifest-v3.schema.json",
  "title": "Evidence-grounded developer-readable prototype manifest",
  "type": "object",
  "required": [
    "schemaVersion", "requirement", "prototype", "delivery", "baselineEvidence",
    "evidenceSources", "pages", "surfaces", "globalRules", "cards"
  ],
  "properties": {
    "schemaVersion": {"const": "3.0.0"},
    "requirement": {
      "type": "object",
      "required": ["id", "title", "coverage", "primarySourceId"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "coverage": {"enum": ["full", "pilot-slice"]},
        "primarySourceId": {"type": "string", "minLength": 1},
        "scope": {"$ref": "#/$defs/scope"}
      },
      "additionalProperties": false
    },
    "prototype": {
      "type": "object",
      "required": ["sourceLabel", "sourcePath", "sourceHash", "sourceRole"],
      "properties": {
        "sourceLabel": {"type": "string", "minLength": 1},
        "sourcePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "sourceHash": {"$ref": "#/$defs/hash"},
        "baselineSourceId": {"type": "string", "minLength": 1},
        "baselineHash": {"$ref": "#/$defs/hash"},
        "baselineKind": {"enum": ["existing-prototype", "first-generation"]},
        "sourceRole": {"const": "current-workspace-prototype"}
      },
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "required": ["mode", "readerRole", "riskTriggers"],
      "properties": {
        "mode": {"const": "standard"},
        "readerRole": {"const": "derived-readonly"},
        "riskTriggers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["first-real-use", "rule-change", "complex-multi-surface", "full-coverage", "evidence-gap-or-conflict", "automatic-degradation", "repeat-failure"]}
        }
      },
      "additionalProperties": false
    },
    "baselineEvidence": {
      "type": "object",
      "required": ["mode", "runtimePage", "code", "screenshots", "conflicts"],
      "properties": {
        "mode": {"enum": ["existing-system-increment", "zero-to-one", "semi-reference"]},
        "runtimePage": {"$ref": "#/$defs/baselineChannel"},
        "code": {"$ref": "#/$defs/baselineChannel"},
        "screenshots": {"$ref": "#/$defs/baselineChannel"},
        "conflicts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "evidenceSources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceSource"}
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pageId", "title", "order"],
        "properties": {
          "pageId": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/surface"}
    },
    "globalRules": {
      "type": "array",
      "items": {"$ref": "#/$defs/globalRule"}
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/card"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "scope": {
      "type": "object",
      "required": ["included", "navigationOnly", "outOfSlice"],
      "properties": {
        "included": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "navigationOnly": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outOfSlice": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "baselineChannel": {
      "type": "object",
      "required": ["availability", "sourceIds", "note"],
      "properties": {
        "availability": {"enum": ["available", "unavailable", "not-applicable"]},
        "sourceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "evidenceSource": {
      "type": "object",
      "required": ["sourceId", "sourceType", "authority", "label", "contentKind", "sourceHash"],
      "properties": {
        "sourceId": {"type": "string", "minLength": 1},
        "sourceType": {"enum": ["prd", "decision", "runtime", "code", "screenshot", "prototype-baseline"]},
        "authority": {"enum": ["current-product-requirement", "confirmed-product-decision", "observed-runtime", "current-code", "same-version-screenshot", "current-prototype-baseline"]},
        "label": {"type": "string", "minLength": 1},
        "contentKind": {"enum": ["text", "html", "source-code", "image"]},
        "sourceHash": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "sourceRef": {
      "type": "object",
      "required": ["sourceId", "locator"],
      "properties": {
        "sourceId": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "excerpt": {"type": "string", "minLength": 4}
      },
      "additionalProperties": false
    },
    "evidenceBinding": {
      "type": "object",
      "required": ["claimPath", "sourceRefs"],
      "properties": {
        "claimPath": {"type": "string", "pattern": "^/"},
        "sourceRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}}
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["type", "selector"],
      "properties": {
        "type": {"enum": ["click", "assert-visible", "assert-hidden"]},
        "selector": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "surface": {
      "type": "object",
      "required": ["surfaceId", "kind", "rootSelector", "activeSelector", "parentSurfaceIds", "exitActions", "exitGuardSurfaceIds", "snapshotSelectors"],
      "properties": {
        "surfaceId": {"type": "string", "minLength": 1},
        "kind": {"enum": ["view", "drawer", "modal"]},
        "rootSelector": {"type": "string", "minLength": 1},
        "activeSelector": {"type": "string", "minLength": 1},
        "parentSurfaceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exitActions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "exitGuardSurfaceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "snapshotSelectors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "required": ["kind", "selector", "enterActions", "manualPath"],
      "properties": {
        "kind": {"enum": ["element", "region"]},
        "selector": {"type": "string", "minLength": 1},
        "enterActions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "manualPath": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": ["name", "control"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "control": {"type": "string", "minLength": 1},
        "defaultValue": {"type": ["string", "boolean", "number", "null"]},
        "required": {"type": "boolean"},
        "options": {"type": "array", "items": {"type": "string"}},
        "visibility": {"type": "string"},
        "enabledWhen": {"type": "string"},
        "validation": {"type": "string"},
        "linkage": {"type": "string"}
      },
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "required": ["precondition", "action", "feedback", "result", "failure"],
      "properties": {
        "precondition": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "feedback": {"type": "string", "minLength": 1},
        "result": {"type": "string", "minLength": 1},
        "failure": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "pendingItem": {
      "type": "object",
      "required": ["question", "owner", "impact", "blocksDelivery"],
      "properties": {
        "question": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "blocksDelivery": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "globalRule": {
      "type": "object",
      "required": ["ruleId", "title", "summary", "scope", "appliesToPageIds", "nonLocatableReason", "rules", "evidenceBindings", "pendingItems"],
      "properties": {
        "ruleId": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "scope": {"enum": ["multi-page", "all-pages"]},
        "appliesToPageIds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "nonLocatableReason": {"enum": ["cross-page-policy", "system-wide-constraint"]},
        "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidenceBindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceBinding"}},
        "pendingItems": {"type": "array", "items": {"$ref": "#/$defs/pendingItem"}}
      },
      "additionalProperties": false
    },
    "card": {
      "type": "object",
      "required": ["cardId", "displayNumber", "requirementId", "pageId", "surfaceId", "region", "title", "summary", "changeKinds", "changeContent", "fields", "rules", "interactions", "errors", "pendingItems", "evidenceBindings", "anchor", "history"],
      "properties": {
        "cardId": {"type": "string", "minLength": 1},
        "displayNumber": {"type": "string", "minLength": 1},
        "requirementId": {"type": "string", "minLength": 1},
        "pageId": {"type": "string", "minLength": 1},
        "surfaceId": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "changeKinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["add", "modify", "delete", "critical-reuse"]}},
        "changeContent": {"type": "object"},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "rules": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "interactions": {"type": "array", "items": {"$ref": "#/$defs/interaction"}},
        "errors": {"type": "array", "items": {"type": "object"}},
        "pendingItems": {"type": "array", "items": {"$ref": "#/$defs/pendingItem"}},
        "evidenceBindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceBinding"}},
        "anchor": {"$ref": "#/$defs/anchor"},
        "history": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    }
  }
}
