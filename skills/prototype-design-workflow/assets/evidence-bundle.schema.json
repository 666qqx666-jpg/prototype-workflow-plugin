{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.prototype-design-workflow/evidence-bundle-v1.schema.json",
  "title": "Local evidence bundle for manifest validation",
  "type": "object",
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourceId", "sourceType", "path", "origin"],
        "properties": {
          "sourceId": {"type": "string", "minLength": 1},
          "sourceType": {"enum": ["prd", "decision", "runtime", "code", "screenshot", "prototype-baseline"]},
          "path": {"type": "string", "minLength": 1},
          "origin": {
            "type": "object",
            "required": ["kind", "locator"],
            "properties": {
              "kind": {"enum": ["workspace-file", "user-provided", "task-record", "captured-runtime"]},
              "locator": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
